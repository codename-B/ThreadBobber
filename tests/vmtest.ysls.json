{
  "version": 3,
  "commands": [
    {"yarnName": "sync_cmd", "definitionName": "sync_cmd", "documentation": "Completes immediately; the test host records it.",
     "parameters": [{"name": "value", "type": "number", "documentation": "Recorded value"}]},
    {"yarnName": "async_cmd", "definitionName": "async_cmd", "documentation": "Leaves the VM waiting until the test host continues.",
     "parameters": [{"name": "label", "type": "string", "documentation": "Recorded label"}]},
    {"yarnName": "flag_cmd", "definitionName": "flag_cmd", "documentation": "Bool argument round trip.",
     "parameters": [{"name": "on", "type": "bool", "documentation": "Recorded flag"}]}
  ],
  "functions": [
    {"yarnName": "host_number", "definitionName": "host_number", "documentation": "Returns a number the test host controls.", "return": {"type": "number"},
     "parameters": []},
    {"yarnName": "host_flag", "definitionName": "host_flag", "documentation": "Returns a bool the test host controls.", "return": {"type": "bool"},
     "parameters": [{"name": "index", "type": "number", "documentation": "Which flag"}]},
    {"yarnName": "durability_for", "definitionName": "durability_for", "async": true, "return": {"type": "number"},
     "parameters": [{"name": "tool", "type": "instance", "subtype": "Tool"}, {"name": "cancel", "type": "token"}]}
  ]
}
